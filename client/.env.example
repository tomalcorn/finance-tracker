# Copy to .env.local (gitignored) and fill in. All four are public: they end up
# in the web bundle. Never put a secret in an EXPO_PUBLIC_ variable.

# Auth0 tenant domain, without https://
EXPO_PUBLIC_AUTH0_DOMAIN=st-finance-tracker.eu.auth0.com
# Client ID of the "Finance Tracker (web app)" SPA application (#283)
EXPO_PUBLIC_AUTH0_CLIENT_ID=
# Prod Supabase project URL and anon key (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
